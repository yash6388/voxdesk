# Copy to .env and fill in real values. Never commit .env.

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# --- Database (matches docker-compose.yml) ---
POSTGRES_USER=voxdesk
POSTGRES_PASSWORD=voxdesk
POSTGRES_DB=voxdesk
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+asyncpg://voxdesk:voxdesk@localhost:5433/voxdesk

# --- Redis ---
REDIS_HOST_PORT=6380
REDIS_URL=redis://localhost:6380/0

# --- LLM (Phase 1) ---
GOOGLE_API_KEY=

# --- Fallback LLM: used automatically if Gemini fails (e.g. free-tier 429) ---
# Any OpenAI-compatible provider. Leave the key empty to disable. Examples:
#   Groq:         https://api.groq.com/openai/v1      openai/gpt-oss-120b   (recommended: free, fast, tools)
#   OpenRouter:   https://openrouter.ai/api/v1         meta-llama/llama-3.3-70b-instruct:free
#   Hugging Face: https://router.huggingface.co/v1     meta-llama/Llama-3.3-70B-Instruct
# (HF_TOKEN / HUGGINGFACE_API_KEY are also accepted as the key.)
FALLBACK_API_KEY=
FALLBACK_BASE_URL=https://router.huggingface.co/v1
FALLBACK_MODEL=meta-llama/Llama-3.3-70B-Instruct
# gemini = Gemini first (default); fallback = fallback model first, Gemini as backup
LLM_PRIMARY=gemini
# Circuit breaker on Gemini: after N outage errors in a row, skip it for COOLDOWN seconds
BREAKER_FAILURE_THRESHOLD=3
BREAKER_COOLDOWN_SECONDS=300

# --- MCP booking server (Phase 2) ---
MCP_URL=http://127.0.0.1:8001/mcp
MCP_API_KEY=dev-mcp-key-change-me

# --- A2A specialist agents (Phase 3) ---
KNOWLEDGE_AGENT_URL=http://127.0.0.1:8101
BOOKING_AGENT_URL=http://127.0.0.1:8102
A2A_API_KEY=dev-a2a-key-change-me

# --- Voice (Phase 4) ---
# local = faster-whisper + Kokoro on this machine; elevenlabs = ElevenLabs API
STT_PROVIDER=local
TTS_PROVIDER=local
WHISPER_MODEL=base.en
KOKORO_VOICE=af_heart
ELEVENLABS_API_KEY=
